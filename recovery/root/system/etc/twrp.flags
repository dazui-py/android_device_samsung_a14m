# Mount point    FSType    Device reference                    Flags
/boot            emmc      /dev/block/by-name/boot             flags=backup=1;flashimg;display="Boot"
/recovery        emmc      /dev/block/by-name/recovery         flags=backup=1;flashimg;display="Recovery"
/cache           ext4      /dev/block/by-name/cache            flags=backup=1;display="Cache"
/efs             ext4      /dev/block/by-name/sec_efs          flags=backup=1;display="EFS"
/metadata        ext4      /dev/block/by-name/md_udc           flags=backup=1;display="Metadata"
/misc            emmc      /dev/block/by-name/misc             flags=display="Misc"

# Partições lógicas para fins de Backup na interface do TWRP
/system_image    emmc      /dev/block/mapper/system            flags=backup=1;flashimg;display="System Image"
/vendor_image    emmc      /dev/block/mapper/vendor            flags=backup=1;flashimg;display="Vendor Image"
/product_image   emmc      /dev/block/mapper/product           flags=backup=1;flashimg;display="Product Image"
/odm_image       emmc      /dev/block/mapper/odm               flags=backup=1;flashimg;display="ODM Image"

# Armazenamento Removível (Cartão SD e Pendrive)
/external_sd     vfat      /dev/block/mmcblk1p1                flags=storage;wipeui;removable;display="MicroSD"
/usb_otg         vfat      /dev/block/sda1                     flags=storage;wipeui;removable;display="USB-OTG"

