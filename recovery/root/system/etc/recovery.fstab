# <src>                                                  <mnt_point>        <type>      <mnt_flags and options>                              <fs_mgr_flags>
system                                                   /system            erofs       ro                                                   logical,first_stage_mount
vendor                                                   /vendor            erofs       ro                                                   logical,first_stage_mount
product                                                  /product           erofs       ro                                                   logical,first_stage_mount
odm                                                      /odm               erofs       ro                                                   logical,first_stage_mount
system_ext                                               /system_ext        erofs       ro                                                   logical,first_stage_mount
vendor_dlkm                                              /vendor_dlkm       erofs       ro                                                   logical,first_stage_mount
system_dlkm                                              /system_dlkm       erofs       ro                                                   logical,first_stage_mount
odm_dlkm                                                 /odm_dlkm          erofs       ro                                                   logical,first_stage_mount

# Partições normais em blocos
/dev/block/by-name/boot                                  /boot              emmc        defaults                                             defaults
/dev/block/by-name/recovery                              /recovery          emmc        defaults                                             defaults
/dev/block/by-name/cache                                 /cache             ext4        noatime,nosuid,nodev                                 wait,check
/dev/block/by-name/sec_efs                               /efs               ext4        defaults                                             wait
/dev/block/by-name/misc                                  /misc              emmc        defaults                                             defaults
/dev/block/by-name/md_udc                                /metadata          ext4        noatime,nosuid,nodev                                 wait,check,formattable,first_stage_mount

# Partição de dados (com as flags de encriptação FBE essenciais do Android 15)
/dev/block/by-name/userdata                              /data              f2fs        noatime,nosuid,nodev,discard,noflush_merge           wait,check,formattable,fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,metadata_encryption=aes-256-xts,keydirectory=/metadata/vold/metadata_encryption

